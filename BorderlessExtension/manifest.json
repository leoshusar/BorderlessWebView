{
    "manifest_version": 3,
    "name": "Borderless WebView",
    "version": "1.0.0",
    "description": "Launches a Borderless WebView app with the current tab's URL.",
    "key": "",
    "permissions": ["activeTab", "scripting", "nativeMessaging"],
    "host_permissions": ["https://*/*"],
    "background": {
        "service_worker": "src/background.js",
        "type": "module"
    },
    "icons": {
        "16": "img/16.png",
        "24": "img/24.png",
        "32": "img/32.png",
        "48": "img/48.png",
        "64": "img/64.png",
        "128": "img/128.png",
        "256": "img/256.png",
        "512": "img/512.png"
    },
    "action": {}
}
