<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(InstallerMode)' == 'Install'">
    <DefineConstants>INSTALL_MODE</DefineConstants>
    <AssemblyName>install</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(InstallerMode)' == 'Uninstall'">
    <DefineConstants>UNINSTALL_MODE</DefineConstants>
    <AssemblyName>uninstall</AssemblyName>
  </PropertyGroup>

</Project>
